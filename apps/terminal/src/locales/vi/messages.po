msgid "market.asset.spcxd.description"
msgstr "$SPCXD là phiên bản token hóa của SpaceX được phát hành qua hạ tầng dShares™ của Dinari, đồng thời là cổ phiếu Mỹ token hóa đầu tiên có thể giao dịch giao ngay trên HyperCore. $SPCXD trên Hyperliquid là dShares™ dạng wrapped và chịu hạn chế, nghĩa là một số quyền gắn với chứng khoán cơ sở bị đóng băng. Nếu ví nắm giữ dShares™ đã hoàn tất KYC với Dinari hoặc đối tác của Dinari, các quyền này có thể tự động được khôi phục mà người nắm giữ token không cần thao tác thêm."

